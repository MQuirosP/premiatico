# ==========================================
# PREMIÁTICO - VARIABLES DE ENTORNO (EJEMPLO)
# Nunca subas archivos .env reales a GitHub
# ==========================================

# --- BACKEND (Render Web Service) ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Base de datos PostgreSQL (Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/premiatico?sslmode=require

# Redis (Render existente - aislamiento estricto por prefijo premiatico:*)
REDIS_URL=redis://default:PASSWORD@HOST:6379

# Autenticación y sesiones administrativas
SESSION_SECRET=replace-with-at-least-32-chars-random-secret
SESSION_COOKIE_NAME=premiatico_admin_session
SESSION_TTL_HOURS=12

# Cloudflare R2 (API compatible S3)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=premiatico-storage
R2_PUBLIC_BASE_URL=https://cdn.premiatico.com

# Resend (Correos transaccionales)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=notificaciones@premiatico.com

# Cloudflare Turnstile (Anti-bot público)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- FRONTEND (Cloudflare Pages - Static Export) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NEXT_PUBLIC_SITE_URL=http://localhost:3000
